[Unit]
Description=Bindizr DNS Synchronization Service
After=network.target named.service

[Service]
Type=simple
ExecStart=/usr/bin/bindizr start
Restart=on-failure
RestartPreventExitStatus=1
RestartSec=5
TimeoutStopSec=30

User=bindizr
Group=bindizr

# The DNS listener defaults to port 53; nothing else here needs privilege.
AmbientCapabilities=CAP_NET_BIND_SERVICE
CapabilityBoundingSet=CAP_NET_BIND_SERVICE

# systemd creates and owns these; a relative database path in the config
# lands in the state directory because the working directory is it.
RuntimeDirectory=bindizr
RuntimeDirectoryMode=0700
StateDirectory=bindizr
StateDirectoryMode=0750
WorkingDirectory=/var/lib/bindizr

NoNewPrivileges=yes
# Nothing the daemon writes is another local user's business.
UMask=0077
# RuntimeDirectory guarantees the socket's primary path, so the daemon's
# /tmp fallback never runs here — and would be invisible to the CLI if it did.
PrivateTmp=yes
ProtectSystem=strict
ProtectHome=yes
ProtectProc=invisible
ProtectClock=yes
ProtectHostname=yes
ProtectKernelLogs=yes
ProtectKernelModules=yes
ProtectKernelTunables=yes
ProtectControlGroups=yes
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
# AF_UNIX carries the daemon socket; the binary is musl, whose resolver
# queries over UDP rather than netlink.
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallFilter=~@privileged @resources

StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
