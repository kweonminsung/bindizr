{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended",
    "helpers:pinGitHubActionDigests"
  ],
  "baseBranchPatterns": [
    "develop"
  ],
  "automerge": true,
  "rangeStrategy": "bumpMinor",
  "packageRules": [
    {
      "description": "A major bump can pass build and tests while changing behaviour, so it waits for a human.",
      "matchUpdateTypes": [
        "major"
      ],
      "automerge": false
    }
  ]
}
